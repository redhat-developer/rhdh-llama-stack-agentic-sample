# OGX Server Container
# Multi-stage build for smaller, more secure image
# Configuration uses ${env.VAR} syntax - resolved at runtime by OGX

# =============================================================================
# BUILDER STAGE
# =============================================================================
FROM registry.access.redhat.com/ubi9/python-312:9.8-1785140801@sha256:ebd0347a0422ad0d24db801972b4c1efa6f3352e5c2553b034e6b70e91235854 AS builder

USER root

ENV UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy

WORKDIR /app-root

# Install build dependencies
RUN dnf install -y gcc python3-devel make && \
    dnf clean all && \
    pip3.12 install uv

# Copy OGX specific dependency specification
COPY ./start-local-ogx/pyproject.toml ./pyproject.toml
COPY ./start-local-ogx/uv.lock ./uv.lock

# Install Python dependencies (deps only; the ogx-server project has no package to build)
RUN uv sync --no-dev --no-install-project

# =============================================================================
# RUNTIME STAGE
# =============================================================================
FROM registry.access.redhat.com/ubi9/python-312-minimal:9.8-1784732125@sha256:fb32c8ad908b78f1595282639a7870028d436579eb73890635b6b867e65faf63

ARG APP_ROOT=/app-root
WORKDIR /app-root

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONCOERCECLOCALE=0 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=UTF-8 \
    LANG=en_US.UTF-8 \
    PATH="/app-root/.venv/bin:$PATH"

# Copy virtual environment from builder
COPY --from=builder --chown=1001:1001 /app-root/.venv ./.venv

# Copy OGX configuration
# Uses ${env.VAR} syntax - resolved at runtime
COPY --chown=1001:1001 ./start-local-ogx/run.yaml ./

# Create data directories for runtime
USER root
RUN mkdir -p /data /data/files && \
    chgrp -R 0 /data /app-root && \
    chmod -R g=u /data /app-root

# License
RUN mkdir -p /licenses
COPY LICENSE /licenses/

# Expose OGX server port
EXPOSE 8321

USER 1001

# Default command - run.yaml is in /app-root
# --insecure: serve plain HTTP. The OGX server is reached only in-cluster
# (app pod -> ogx sidecar on port 8321); no external route is exposed to it.
# OGX 1.2.5+ requires TLS certs otherwise and exits on startup.
CMD ["ogx", "stack", "run", "/app-root/run.yaml", "--insecure"]

# Labels
LABEL com.redhat.component=ogx-agentic \
      description="OGX Agentic AI Server" \
      io.k8s.description="OGX Agentic AI Server" \
      io.k8s.display-name="OGX Agentic" \
      io.openshift.tags="ai,ogx,inference,agents" \
      name=ogx-agentic \
      summary="OGX server for agentic AI workflows"
